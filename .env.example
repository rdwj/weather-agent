# Weather Agent Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: LLM Configuration
# ============================================
# Your LLM API endpoint (OpenAI-compatible)
# Example: https://api.openai.com/v1
LLM_URL=

# API key for LLM authentication
LLM_API_KEY=

# Model name to use for completions
# Example: gpt-4, llama-3, etc.
LLM_MODEL_NAME=

# ============================================
# REQUIRED: MCP Server Configuration
# ============================================
# URL to your MCP weather server
# Default shared weather MCP server (update with your cluster)
MCP_URL=https://mcp-server-weather-mcp.apps.your-cluster.com/mcp/

# Timeout for MCP requests in seconds
MCP_TIMEOUT=30

# ============================================
# OPTIONAL: Redis Configuration
# ============================================
# Password for Redis authentication (leave empty for no auth)
REDIS_PASSWORD=

# Redis host (for local development)
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# ============================================
# OPTIONAL: API Configuration
# ============================================
# Secret key for JWT tokens (will be generated if not provided)
API_SECRET_KEY=

# API host
API_HOST=0.0.0.0

# API port
API_PORT=8000

# ============================================
# OPTIONAL: Application Settings
# ============================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Cache TTL in seconds
CACHE_TTL=3600

# Cache type (redis or memory)
CACHE_TYPE=redis

# ============================================
# DEPLOYMENT NOTES
# ============================================
# For OpenShift deployment:
# 1. Fill in all REQUIRED fields above
# 2. Run: ./scripts/deploy-openshift.sh
#
# For local development:
# 1. Fill in LLM and MCP configurations
# 2. Run: source .venv/bin/activate
# 3. Run: python -m uvicorn src.api.weather_api:app --reload
#
# To update secrets in OpenShift:
# 1. Update this file with new values
# 2. Run: ./scripts/apply-secret.sh